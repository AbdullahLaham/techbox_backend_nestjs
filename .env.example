# Copy to .env and fill in. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start when a required value is missing or too short
# (src/config/env.validation.ts).

# --- Required everywhere -------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/incubator_lms
# At least 24 characters each.
JWT_ACCESS_SECRET=
COOKIE_SECRET=
JWT_ACCESS_EXPIRATION=15m
# Days a refresh token stays valid (default 30).
JWT_REFRESH_EXPIRATION_DAYS=30

# --- Server -----------------------------------------------------------------------------
PORT=5000
# development | production
NODE_ENV=development
# Behind a reverse proxy or PaaS load balancer: number of proxy hops (usually 1).
# TRUST_PROXY=1

# --- Required when NODE_ENV=production -------------------------------------------------
# Comma-separated web origins allowed to call the API (the dashboard). Native apps need none.
CORS_ORIGINS=http://localhost:3000
# Signs file download links (at least 24 characters). Without it links break on restart.
STORAGE_SIGNING_SECRET=
# Public base URL of this API, used in file links. Must be reachable from phones.
PUBLIC_API_URL=http://localhost:5000

# --- Files (local storage) -------------------------------------------------------------
# STORAGE_LOCAL_DIR=./storage

# --- Video (Bunny Stream) --------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# --- First accounts: npm run seed ------------------------------------------------------
SEED_OWNER_EMAIL=abed@techbox.com
# At least 12 characters. Remove from .env after seeding if you prefer.
SEED_OWNER_PASSWORD=
SEED_MANAGER_EMAIL=admin@techbox.com
# Optional: without it the manager account is not created.
SEED_MANAGER_PASSWORD=
# true = also replace the passwords of accounts that already exist.
SEED_RESET_PASSWORDS=false
