model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  programId      String
  status         EnrollmentStatus @default(PENDING) // تبدأ كمعلقة لحين مراجعة الإيصال
  progressPct    Float            @default(0.0)
  paymentReceipt String? // مفتاح ملف إيصال التحويل في StorageService (وليس رابطاً)
  reviewNote     String? // ملاحظة الإدارة عند القبول أو الرفض (تظهر للطالب)
  reviewedAt     DateTime? // تاريخ آخر مراجعة من الإدارة
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId, status])
}

model ProgressLog {
  id              String       @id @default(uuid())
  userId          String
  nodeId          String
  isCompleted     Boolean      @default(false)
  watchedSeconds  Int          @default(0)
  lastPositionSec Int          @default(0)
  completionPct   Float        @default(0.0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  node            ActivityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([userId, isCompleted])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  storageKey   String     @unique // المسار الداخلي أو المفتاح
  fileName     String // الاسم الأصلي للملف للعرض والتحميل
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

enum GlobalRole {
  SUPER_ADMIN
  INCUBATOR_MANAGER
  INSTRUCTOR
  MENTOR
  STUDENT
  GUEST
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProgramType {
  ACADEMIC_COURSE
  INCUBATOR_BATCH
  BOOTCAMP
  WORKSHOP_SERIES
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum NodeType {
  VIDEO_LECTURE
  LIVE_SESSION
  ASSIGNMENT
  READING_MATERIAL
  QUIZ
  MENTORSHIP_CHECKIN
}

enum SubmissionType {
  FILE_UPLOAD
  URL_LINK
  TEXT_CONTENT
  MULTIMEDIA
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  GRADED
  REJECTED
  NEEDS_REVISION
}

enum EnrollmentStatus {
  PENDING // طلب بانتظار مراجعة الإدارة
  ACTIVE // مقبول، يصل إلى المحتوى
  COMPLETED // أنهى البرنامج، يحتفظ بالوصول
  DROPPED // انسحب أو أُخرج بعد القبول
  SUSPENDED // موقوف مؤقتاً، يحتفظ بمقعده
  REJECTED // رُفض الطلب، يمكنه إعادة التقديم
}

enum NodeResourceKind {
  LINK
  FILE
}

enum NotificationType {
  SYSTEM
  ASSIGNMENT_DUE
  GRADED
  ANNOUNCEMENT
}

enum AssignmentStatus {
  DRAFT // مخفي عن الطلاب
  PUBLISHED // مرئي للطلاب المسجلين
  ARCHIVED // مخفي ولكن البيانات محفوظة
}
