generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  status            UserStatus     @default(ACTIVE)
  globalRole        GlobalRole     @default(STUDENT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  enrollments       Enrollment[]
  notifications     Notification[]
  progressLogs      ProgressLog[]
  gradedSubmissions Submission[]   @relation("GraderSubmissions")
  submissions       Submission[]
  profile           UserProfile?
  sessions          UserSession[]

  @@index([email])
  @@index([globalRole, status])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String?  @unique
  avatarUrl   String?
  bio         String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model Program {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  type        ProgramType   @default(ACADEMIC_COURSE)
  status      ProgramStatus @default(DRAFT)
  coverImage  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enrollments Enrollment[]
  tracks      Track[]

  @@index([status, type])
}

model Track {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, orderIndex])
}

model Module {
  id          String         @id @default(uuid())
  trackId     String
  title       String
  description String?
  orderIndex  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  nodes       ActivityNode[]
  track       Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, orderIndex])
}

model ActivityNode {
  id          String        @id @default(uuid())
  moduleId    String
  title       String
  description String?
  type        NodeType
  orderIndex  Int           @default(0)
  isMandatory Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignment  Assignment?
  progress    ProgressLog[]
  video       VideoAsset?

  @@index([moduleId, orderIndex])
  @@index([type])
}

model VideoAsset {
  id             String       @id @default(uuid())
  nodeId         String       @unique
  externalId     String
  provider       String       @default("BUNNY_STREAM")
  durationSec    Int
  playbackUrl    String
  transcodeState String       @default("PROCESSING")
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  node           ActivityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           String         @id @default(uuid())
  nodeId       String         @unique
  instructions String
  allowedType  SubmissionType @default(URL_LINK)
  maxScore     Decimal        @default(100.00) @db.Decimal(5, 2)
  dueDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  node         ActivityNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submissions  Submission[]
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  payload      Json
  status       SubmissionStatus @default(SUBMITTED)
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  gradedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  grader       User?            @relation("GraderSubmissions", fields: [gradedBy], references: [id])
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
  @@index([status])
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  programId   String
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Float            @default(0.0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  program     Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}

model ProgressLog {
  id              String       @id @default(uuid())
  userId          String
  nodeId          String
  isCompleted     Boolean      @default(false)
  watchedSeconds  Int          @default(0)
  lastPositionSec Int          @default(0)
  completionPct   Float        @default(0.0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  node            ActivityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([userId, isCompleted])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum GlobalRole {
  SUPER_ADMIN
  INCUBATOR_MANAGER
  INSTRUCTOR
  MENTOR
  STUDENT
  GUEST
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProgramType {
  ACADEMIC_COURSE
  INCUBATOR_BATCH
  BOOTCAMP
  WORKSHOP_SERIES
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum NodeType {
  VIDEO_LECTURE
  LIVE_SESSION
  ASSIGNMENT
  READING_MATERIAL
  QUIZ
  MENTORSHIP_CHECKIN
}

enum SubmissionType {
  FILE_UPLOAD
  URL_LINK
  TEXT_CONTENT
  MULTIMEDIA
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  GRADED
  REJECTED
  NEEDS_REVISION
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum NotificationType {
  SYSTEM
  ASSIGNMENT_DUE
  GRADED
  ANNOUNCEMENT
}
