model Program {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  type        ProgramType   @default(ACADEMIC_COURSE)
  status      ProgramStatus @default(DRAFT)
  coverImage  String?

  // === خصائص الدفعة والمقاعد (Cohort-Based Scarcity) ===
  maxSeats         Int?      @default(30) // الحد الأقصى للمقاعد
  startDate        DateTime? // تاريخ بدء الدفعة
  endDate          DateTime? // تاريخ انتهاء الدفعة
  isEnrollmentOpen Boolean   @default(true) // هل التسجيل مفتوح؟

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  tracks      Track[]

  @@index([status, type])
}

model Track {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, orderIndex])
}

model Module {
  id          String         @id @default(uuid())
  trackId     String
  title       String
  description String?
  orderIndex  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  nodes       ActivityNode[]
  track       Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, orderIndex])
}

model ActivityNode {
  id          String        @id @default(uuid())
  moduleId    String
  title       String
  description String?
  type        NodeType
  orderIndex  Int           @default(0)
  isMandatory Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignment  Assignment?
  progress    ProgressLog[]
  video       VideoAsset?
  resource    NodeResource?
  quiz        Quiz?

  @@index([moduleId, orderIndex])
  @@index([type])
}

// محتوى الدرس القرائي: رابط خارجي أو ملف مخزّن (مفتاح StorageService وليس رابطاً)
model NodeResource {
  id         String           @id @default(uuid())
  nodeId     String           @unique
  kind       NodeResourceKind
  url        String? // kind = LINK
  storageKey String?          @unique // kind = FILE
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  node       ActivityNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// اختبار قصير مرتبط بدرس من نوع QUIZ
model Quiz {
  id                 String         @id @default(uuid())
  nodeId             String         @unique
  title              String
  description        String?
  passingScore       Decimal        @default(0) @db.Decimal(7, 2) // علامة النجاح
  maxAttempts        Int? // null = غير محدود
  showCorrectAnswers Boolean        @default(true) // إظهار الإجابات الصحيحة بعد التسليم
  isPublished        Boolean        @default(false) // لا يراه الطلاب قبل النشر
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  node               ActivityNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  questions          QuizQuestion[]
  attempts           QuizAttempt[]
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  text        String
  explanation String? // يظهر للطالب بعد التسليم
  points      Decimal      @default(1) @db.Decimal(6, 2) // وزن السؤال
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuizOption[]

  @@index([quizId, orderIndex])
}

// أربعة خيارات لكل سؤال، واحد منها صحيح. isCorrect لا يُرسل للطلاب أبداً
model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

// محاولة طالب: الإجابات والنتيجة ونسخة ثابتة من التصحيح وقت التسليم
model QuizAttempt {
  id            String   @id @default(uuid())
  quizId        String
  studentId     String
  attemptNumber Int // 1 للمحاولة الأولى لهذا الطالب
  answers       Json // [{ questionId, optionId | null }]
  result        Json // تصحيح كل سؤال كما كان وقت التسليم
  score         Decimal  @db.Decimal(7, 2)
  totalScore    Decimal  @db.Decimal(7, 2)
  passingScore  Decimal  @db.Decimal(7, 2)
  passed        Boolean
  submittedAt   DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, submittedAt])
}

model VideoAsset {
  id             String       @id @default(uuid())
  nodeId         String       @unique
  externalId     String
  provider       String       @default("BUNNY_STREAM")
  durationSec    Int
  playbackUrl    String
  transcodeState String       @default("PROCESSING")
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  node           ActivityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           String                 @id @default(uuid())
  nodeId       String                 @unique
  instructions String
  allowedType  SubmissionType         @default(URL_LINK)
  maxScore     Decimal                @default(100.00) @db.Decimal(5, 2)
  dueDate      DateTime?
  status       AssignmentStatus       @default(DRAFT) // جديد
  publishedAt  DateTime? // تاريخ أول نشر
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  node         ActivityNode           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  attachments  AssignmentAttachment[] // جديد

  @@index([status])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  payload      Json
  status       SubmissionStatus @default(SUBMITTED)
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  gradedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  grader       User?            @relation("GraderSubmissions", fields: [gradedBy], references: [id])
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
  @@index([status])
}

